# Optional: enrich signals with LLM (falls back to rules-only if unset)
OPENAI_API_KEY=

# Trading pair and timeframe (Binance public klines)
SYMBOL=BTCUSDT
INTERVAL=1h
LOOKBACK_BARS=3000

# Risk (fractions of equity)
RISK_PER_TRADE=0.01
MAX_POSITION_FRACTION=0.25
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
MAX_DRAWDOWN_HALT=0.15

# ATR stops (preferred over fixed % when USE_ATR_STOPS=true)
USE_ATR_STOPS=true
ATR_STOP_MULT=1.5
ATR_TP_MULT=3.0
MIN_STOP_PCT=0.005
MAX_STOP_PCT=0.06

# Strategy mode: funding_tilt (default) | trend_ride | pullback
STRATEGY_MODE=funding_tilt
LONG_ONLY=true
EXIT_ON_SIGNAL_FLIP=true
TREND_POSITION_FRACTION=0.95
TREND_ATR_STOP_MULT=8.0
FUNDING_LOOKBACK=24
FUNDING_LONG_MAX=0.0
FUNDING_FLAT_MIN=0.00005

# Pullback-mode filters (ignored by trend_ride except HTF/EMA)
MIN_SIGNAL_SCORE=0.60
REQUIRE_HTF_ALIGN=true
REQUIRE_PULLBACK=true
REQUIRE_BB_PULLBACK=true
REQUIRE_EMA_STACK=true
RSI_PULLBACK_MAX=38
RSI_BOUNCE_MIN=62
HTF_RULE=4h
HTF_EMA_SPAN=50
WARMUP_BARS=220

# Paper trading starting balance (USDT)
INITIAL_EQUITY=10000
